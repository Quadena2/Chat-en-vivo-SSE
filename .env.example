# Copia este archivo como ".env" y ajusta los valores
#   PowerShell:  Copy-Item .env.example .env

# --- Flask ---
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# 1 = modo desarrollo (recarga automatica + errores detallados), 0 = desactivado
FLASK_DEBUG=1

# --- Redis (contenedor Docker) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Dejar vacio si Redis no tiene contrasena
REDIS_PASSWORD=

# --- Chat ---
# Mensajes maximos que se guardan por sala (LTRIM)
MAX_MENSAJES_HISTORIAL=100
# Mensajes que se muestran al abrir una sala (LRANGE)
MENSAJES_POR_PAGINA=50

# --- Presencia en tiempo real (segundos) ---
# Cada cuanto una conexion abierta renueva su latido en Redis
INTERVALO_LATIDO_SEGUNDOS=5
# Tiempo sin latido tras el cual una conexion se considera muerta
PRESENCIA_TTL_SEGUNDOS=15
