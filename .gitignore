.coverage
htmlcov/

# IDEs y editores (PyCharm, VS Code)
.idea/
.vscode/
*.swp
*.swo

# Archivos de persistencia local de Redis (si se ejecuta en el directorio)
dump.rdb
appendonly.aof
appendonlydir/

# Archivos de log y sistema operativo
*.log
Thumbs.db
.DS_Store
